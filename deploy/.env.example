# Sao chép thành deploy/.env (setup.sh làm giúp). KHÔNG commit deploy/.env.

POSTGRES_USER=cris
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=cris

# Cổng máy chủ web trên máy host
CRIS_PORT=8000

# AI: none (mặc định) | local. Chọn local thì đặt CRIS_EXTRAS=[ai] TRƯỚC khi dựng ảnh.
CRIS_AI_PROVIDER=none
CRIS_EXTRAS=

# Người dùng mặc định tạo lúc cài (vai rd_officer)
CRIS_ADMIN_EMAIL=rd@ictu.edu.vn
CRIS_ADMIN_NAME=Chuyên viên Phòng KH-CN
